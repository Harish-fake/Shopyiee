# ---------------------------------------------------------------------------
# ShopSphere - example environment configuration
#
# Copy this file to `.env` and replace every placeholder before starting the
# stack.  Never commit the resulting `.env` file.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development : full storefront, demo/sample dataset, internal test endpoints enabled
# testing     : same as development, used by the automated test suite
# secure      : hardened build - parameterised SQL, server-side pricing,
#               encoded output, strict server-side authorization
APP_MODE=development

NODE_ENV=development
PORT=5000

# Interface the API binds to.
#   127.0.0.1  loopback only - the default, and what you want on a laptop so
#              the storefront is not exposed to whatever network you are on.
#   0.0.0.0    all interfaces - only for containers, or a host that is already
#              protected by a firewall / VPN / reverse proxy.  See the
#              deployment section of README.md before changing this.
HOST=127.0.0.1

# Public origin of the frontend, used for CORS and cookie settings.
FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=shopping_store
DB_USER=shop_app
DB_PASSWORD=change_me_app_password
DB_ROOT_PASSWORD=change_me_root_password

DB_CONNECTION_LIMIT=10

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# Generate a fresh value with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_generate_a_long_random_session_secret
SESSION_NAME=shop.sid
SESSION_MAX_AGE_MS=86400000

# ---------------------------------------------------------------------------
# Seed accounts (LOCAL DEMO DATA ONLY - not real credentials)
# These are only used the very first time the database is initialised.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@shopsphere.test
SEED_ADMIN_PASSWORD=AdminDemo#2024
SEED_USER_EMAIL=priya@example.test
SEED_USER_PASSWORD=UserDemo#2024

# Starting simulated wallet balance for newly registered accounts (no real money).
WALLET_STARTING_BALANCE=10000.00

# ---------------------------------------------------------------------------
# Hardening (used when APP_MODE=secure)
# ---------------------------------------------------------------------------
# Enable CSRF protection on state-changing secure routes.
ENABLE_CSRF=true

# Enable request rate limiting.
ENABLE_RATE_LIMIT=true

# Trust the reverse proxy in front of the app (set to 1 when behind nginx/VPN gateway).
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# combined | dev | short | tiny | none
HTTP_LOG_FORMAT=dev
LOG_LEVEL=info

# Unexpected failures always return a generic message to the client; the full
# detail (including the raw driver error) goes to the server log.  Set this to
# true only while debugging locally - a driver error can quote the offending
# SQL, a filesystem path or a connection string.
EXPOSE_ERROR_DETAILS=false

# ---------------------------------------------------------------------------
# Docker Compose host ports
# ---------------------------------------------------------------------------
# Only read when the app is started with `docker compose up`.
#
# WEB_BIND controls which host interface the storefront is published on.
#   127.0.0.1  loopback only - the default.  You reach the shop at
#              http://localhost:3000 and nobody else on your network can.
#   0.0.0.0    all interfaces - only on a host that is already protected by a
#              firewall, a VPN, or a reverse proxy.  See README.md.
#
# The API (API_PORT) and MySQL are never published beyond loopback: MySQL has
# no published port at all and lives on an internal-only Docker network.
WEB_BIND=127.0.0.1
WEB_PORT=3000
API_PORT=5000
